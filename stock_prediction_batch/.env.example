# 株価予測システムの秘密情報
# 値を書き換えてから使う。= の前後に空白を入れない

# J-Quants のAPIキー
JQUANTS_API_KEY=

# 送信に使う Gmail のアドレスとアプリパスワード
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 通知メールの宛先。書かなければ GMAIL_ADDRESS に送る
# 毎日の通知・補完分・空振りのメールの宛先。カンマ区切りで複数のメールアドレスを指定できる(1人ずつ送るので、他の宛先は知らされない)。指定しない場合は GMAIL_ADDRESS
MAIL_TO=
# 失敗・警告のメール(管理者向け)の宛先。カンマ区切りで複数のメールアドレスを指定できる(1人ずつ送るので、他の宛先は知らされない)。指定しない場合は MAIL_TO、それもなければ GMAIL_ADDRESS
ADMIN_MAIL_TO=

# PostgreSQL の接続情報
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
